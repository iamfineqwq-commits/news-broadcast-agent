    {
      "parameters": {
        "jsCode": "// ============================================\n// 格式化日期为 YYYY-MM-DD\n// 适配你 Edit Fields 输出的数据结构\n// ============================================\n\nfor (const item of $input.all()) {\n  // 获取原始日期字符串\n  const rawDate = item.json[\"日期\"];\n\n  let formattedDate = null;\n  let parseSuccess = false;\n\n  if (rawDate) {\n    try {\n      // 使用 JavaScript 内置 Date 解析\n      const dateObj = new Date(rawDate);\n      \n      // 验证解析是否成功\n      if (!isNaN(dateObj.getTime())) {\n        const year = dateObj.getFullYear();\n        const month = String(dateObj.getMonth() + 1).padStart(2, '0');\n        const day = String(dateObj.getDate()).padStart(2, '0');\n        formattedDate = `${year}-${month}-${day}`;\n        parseSuccess = true;\n      }\n    } catch (e) {\n      // 解析失败则保留原始值\n    }\n  }\n\n  // 将格式化的结果写回 item.json\n  // 替换原始字段，或创建新字段，这里采用替换\n  item.json[\"日期\"] = parseSuccess ? formattedDate : (rawDate || null);\n  // 如果你需要保留原始日期用于对比，可以新建一个字段：\n  // item.json[\"日期_原始\"] = rawDate;\n  // item.json[\"日期_标准化\"] = formattedDate;\n}\n\nreturn $input.all();"
      },
